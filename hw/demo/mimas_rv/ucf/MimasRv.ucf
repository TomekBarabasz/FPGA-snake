#######################################################################################
#  Mimas V2 (XC6SLX9-3 CSG324) - MimasRv: microrv32 + monitor UART + LPDDR
#
#  Top: demo/mimas_rv/hw/gen/MimasRv.v
#    sbt "demo-mimas-rv/runMain newhope.mimasrv.MimasRvVerilog"
#  + 9 plikow MIG z lib/mimas_v2/hw/spinal/main/mcb/MIG-128b.
#
#  Zegary: 100 MHz -> PLL w s6_lpddr -> pamiec 150 MHz, c3_clk0 50 MHz (cala logika),
#  mcb_drp_clk 60 MHz (MigConfig.forClocks(150, 50)). Jedno PERIOD na wejsciu wystarczy,
#  ISE wyprowadza ograniczenia wyjsc PLL (sprawdz TS_SYS_CLK3 w .twr).
#  Ograniczenia MCB i piny LPDDR 1:1 z voice-changer (MelPipelineMimas.ucf, sprawdzone po PAR).
#  c3_sys_rst_n nie jest pinem (reset MCB na stale nieaktywny) - SW3 (M16) to zwykly przycisk.
#######################################################################################

CONFIG VCCAUX = "3.3" ;
CONFIG MCB_PERFORMANCE = STANDARD ;

NET "c3_sys_clk" LOC = V10 | IOSTANDARD = LVCMOS33;

# ---- ograniczenia czasowe MCB (MCB-README §5.6) ----------------------------------------
NET "*/memc3_infrastructure_inst/sys_clk_ibufg" TNM_NET = "SYS_CLK3" ;
TIMESPEC "TS_SYS_CLK3" = PERIOD "SYS_CLK3" 10 ns HIGH 50 % ;
NET "*/c?_pll_lock" TIG ;
NET "*/memc?_wrapper_inst/mcb_ui_top_inst/mcb_raw_wrapper_inst/selfrefresh_mcb_mode" TIG ;

# calib_done: z mcb_drp_clk (60 MHz) do c3_clk0 (50 MHz) przez BufferCC. Zegary pokrewne
# (VCO/10 i VCO/12), wiec bez TIG ISE liczy te sciezke od najblizszych zboczy.
INST "c3_calib_done_buffercc/buffers_0" TNM = "TNM_calib_sync" ;
TIMESPEC "TS_calib_cdc" = FROM "FFS" TO "TNM_calib_sync" TIG ;

# ---- LPDDR MT46H32M16 (bank 3) ----------------------------------------------------------
NET "mcb3_dram_a[0]" LOC = J7 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[10]" LOC = F4 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[11]" LOC = D3 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[12]" LOC = G6 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[1]" LOC = J6 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[2]" LOC = H5 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[3]" LOC = L7 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[4]" LOC = F3 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[5]" LOC = H4 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[6]" LOC = H3 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[7]" LOC = H6 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[8]" LOC = D2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_a[9]" LOC = D1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_ba[0]" LOC = F2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_ba[1]" LOC = F1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_cas_n" LOC = K5 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_ck" LOC = G3 | IOSTANDARD = DIFF_MOBILE_DDR;
NET "mcb3_dram_ck_n" LOC = G1 | IOSTANDARD = DIFF_MOBILE_DDR;
NET "mcb3_dram_cke" LOC = H7 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dm" LOC = K3 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[0]" LOC = L2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[10]" LOC = N2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[11]" LOC = N1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[12]" LOC = T2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[13]" LOC = T1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[14]" LOC = U2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[15]" LOC = U1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[1]" LOC = L1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[2]" LOC = K2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[3]" LOC = K1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[4]" LOC = H2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[5]" LOC = H1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[6]" LOC = J3 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[7]" LOC = J1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[8]" LOC = M3 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dq[9]" LOC = M1 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_dqs" LOC = L4 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_ras_n" LOC = L5 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_udm" LOC = K4 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_udqs" LOC = P2 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_dram_we_n" LOC = E3 | IOSTANDARD = MOBILE_DDR;
NET "mcb3_rzq" LOC = N4 | IOSTANDARD = MOBILE_DDR;

# ---- UART, przyciski (SW1 = reset CPU), DIP, LED, 7-seg ---------------------------------
# UART do PIC-a: 115200 8N1 (SBSUart w microrv32) = firmware PIC-a jimmo, drugi port COM.
# Schemat: PIC TX -> A8 (wejscie FPGA), PIC RX <- B8 (wyjscie FPGA).
NET "uart_rx"    LOC = A8  | IOSTANDARD = LVCMOS33 | PULLUP ;
NET "uart_tx"    LOC = B8  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;

# Push buttons SW1..SW6, active low. SW1 = reset.
NET "btn_n[0]"   LOC = M18 | IOSTANDARD = LVCMOS33 | PULLUP ;   # SW1 (reset)
NET "btn_n[1]"   LOC = L18 | IOSTANDARD = LVCMOS33 | PULLUP ;   # SW2
NET "btn_n[2]"   LOC = M16 | IOSTANDARD = LVCMOS33 | PULLUP ;   # SW3
NET "btn_n[3]"   LOC = L17 | IOSTANDARD = LVCMOS33 | PULLUP ;   # SW4
NET "btn_n[4]"   LOC = K17 | IOSTANDARD = LVCMOS33 | PULLUP ;   # SW5
NET "btn_n[5]"   LOC = K18 | IOSTANDARD = LVCMOS33 | PULLUP ;   # SW6

# DIP switch, active low (ON = 0 on the pin, 1 in Forth at 0x80). Index = silkscreen:
# DP1 is pin F17. Numato's reference UCF and the schematic net names (DP1 = C17) count
# the other way round - same convention as NewHope/aht10 and voice-changer.
NET "dip_n[0]"   LOC = F17 | IOSTANDARD = LVCMOS33 | PULLUP ;   # DP1
NET "dip_n[1]"   LOC = F18 | IOSTANDARD = LVCMOS33 | PULLUP ;   # DP2
NET "dip_n[2]"   LOC = E16 | IOSTANDARD = LVCMOS33 | PULLUP ;   # DP3
NET "dip_n[3]"   LOC = E18 | IOSTANDARD = LVCMOS33 | PULLUP ;   # DP4
NET "dip_n[4]"   LOC = D18 | IOSTANDARD = LVCMOS33 | PULLUP ;   # DP5
NET "dip_n[5]"   LOC = D17 | IOSTANDARD = LVCMOS33 | PULLUP ;   # DP6
NET "dip_n[6]"   LOC = C18 | IOSTANDARD = LVCMOS33 | PULLUP ;   # DP7
NET "dip_n[7]"   LOC = C17 | IOSTANDARD = LVCMOS33 | PULLUP ;   # DP8

# LEDs D1..D8, active high
NET "led[0]"     LOC = P15 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # D1
NET "led[1]"     LOC = P16 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # D2
NET "led[2]"     LOC = N15 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # D3
NET "led[3]"     LOC = N16 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # D4
NET "led[4]"     LOC = U17 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # D5
NET "led[5]"     LOC = U18 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # D6
NET "led[6]"     LOC = T17 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # D7
NET "led[7]"     LOC = T18 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # D8

# Seven-segment display (common anode): segments and digit enables active low
NET "seg[0]"     LOC = A3 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # a
NET "seg[1]"     LOC = B4 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # b
NET "seg[2]"     LOC = A4 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # c
NET "seg[3]"     LOC = C4 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # d
NET "seg[4]"     LOC = C5 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # e
NET "seg[5]"     LOC = D6 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # f
NET "seg[6]"     LOC = C6 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # g
NET "seg[7]"     LOC = A5 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # dot
NET "en[0]"      LOC = B2 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # left digit
NET "en[1]"      LOC = A2 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # middle
NET "en[2]"      LOC = B3 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;   # right

# Wejscia asynchroniczne: synchronizowane w projekcie
NET "btn_n[*]"   TIG ;
NET "dip_n[*]"   TIG ;
NET "uart_rx"    TIG ;
